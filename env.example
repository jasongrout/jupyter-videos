# Copy to .env, fill in, and load with: set -a; . ./.env; set +a
# Every variable has a default; only the ones of the steps you run are needed.

# Takes, voice clips, music, parts and renders (default: work/ in this repository).
RV_WORK=
# The servers' folders: root, settings, workspaces, environments (default: $RV_WORK/runtime).
RV_BASE=

# A JupyterLab checkout with node_modules, for setup/build_main.sh and the icons of the cards.
JUPYTERLAB_SRC=
# The jupyter-lab of a development install of JupyterLab, for the `main` server.
JLAB_DEV_BIN=
# A Python with pandas and matplotlib, to run the demo notebooks once (setup/make_demo.py).
DEMO_PYTHON=

# Browser and tools (defaults: the playwright-core of this repository, the newest Chromium headless shell
# in Playwright's cache, ffmpeg on the PATH).
PLAYWRIGHT_CORE=
RV_CHROMIUM=
FFMPEG=

# Narration with ElevenLabs through OpenRouter (voice/el_voice.py). Keep the key out of the repository.
OPENROUTER_API_KEY=
# Draft narration with Piper (voice/voice.py).
PIPER=
PIPER_VOICE=
# The transcription check (voice/stt.py).
MOONSHINE_MODEL=

# The local model server of the AI shot (ai/local_llm_server.py).
LLM_THREADS=6
LLM_URL=http://localhost:8080/v1
